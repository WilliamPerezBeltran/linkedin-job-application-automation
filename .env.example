# Copiar a .env y completar con valores reales. .env nunca se comitea (ver .gitignore).

# Base de datos
# DATABASE_URL debe coincidir con las credenciales usadas por el servicio "postgres"
# de docker-compose.yml (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB/POSTGRES_PORT abajo).
DATABASE_URL=postgresql://user:password@localhost:5432/jobs_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=jobs_db
POSTGRES_PORT=5432

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_RETRIES=2
# Reservado para prompt caching (Anthropic `cache_control` / OpenAI cached
# input, ver TOKEN_OPTIMIZATION.md §5) — NO leído por ningún código todavía
# (verificado por token-optimization-agent, revisión post-Fase 5: cero
# referencias a esta variable en app/**). No lo actives asumiendo que hace
# algo hoy. Además, implementarlo ahora no traería ahorro medible: los
# system prompts actuales (`prompts/job-analysis/v1.txt` ≈ 506 tokens,
# `prompts/email-generation/v1.txt` ≈ 680 tokens, estimado ~4 chars/token)
# están por debajo del mínimo cacheable de Anthropic (1024 tokens general,
# 2048 para la familia Haiku usada en el Analyzer) — ver
# docs/optimization/llm-cost-analysis.md, entrada 2026-09-16, y
# docs/optimization/token-budget.md. Revisar de nuevo si el system prompt
# crece sustancialmente (ej. few-shot examples) o si el volumen de batch
# lo justifica.
LLM_CACHE_ENABLED=true
# Modelo barato/rápido para el Job Analyzer (Fase 3, alto volumen de llamadas)
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Modelo intermedio/grande para el Email Generator (Fase 5, exige mejor calidad de texto)
ANTHROPIC_EMAIL_MODEL=claude-3-5-sonnet-latest

# Gmail OAuth 2.0 (Google Cloud Console)
# Nota (gmail-agent, Fase 7): estas dos ya no son leídas directamente por
# ningún código -- el flujo real (`app/infrastructure/gmail/gmail_client.py`)
# usa `InstalledAppFlow.from_client_secrets_file` contra el propio
# `credentials.json` (GMAIL_CREDENTIALS_PATH abajo), que ya contiene
# client_id/client_secret tal como Google Cloud Console lo genera. Se
# mantienen declaradas por si en el futuro se agrega un flujo alternativo
# que sí las necesite por separado; hoy no tienen efecto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ruta al `credentials.json` descargado de Google Cloud Console (tipo de
# credencial OAuth "Desktop app", con la Gmail API habilitada) -- nunca
# comitear ese archivo (ver .gitignore). Ver los pasos completos para
# generarlo en el docstring de app/infrastructure/gmail/gmail_client.py.
GMAIL_CREDENTIALS_PATH=credentials.json
# Ruta donde se persiste el token OAuth ya autorizado (creado
# automáticamente tras la primera autorización interactiva, permisos 0600,
# nunca comitear -- ver .gitignore). Borrar este archivo fuerza una nueva
# autorización interactiva en la siguiente corrida.
GMAIL_TOKEN_PATH=token.json

# LinkedIn — nunca guardar la contraseña aquí en texto plano de forma permanente;
# usar solo para el primer login manual/controlado que genera storage_state.json (gitignored)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Scheduler (Fase 9, ROADMAP.md) — hora del día (0-23, hora local del proceso)
# a la que corre el pipeline diario completo (app/presentation/scheduler/jobs.py):
# CollectFeedPosts -> AnalyzeJobPost -> SelectBestCV -> GenerateApplicationEmail.
# Arrancar el proceso por separado con: python -m app.presentation.scheduler.jobs
SCHEDULER_DAILY_HOUR=8
